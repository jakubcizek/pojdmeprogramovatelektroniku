# ==== Časomíra: výchozí konfigurace projektu ====
# Aplikuje se při čerstvé konfiguraci (když neexistuje sdkconfig)

# Bezdrátové ovládání: Bluetooth LE, host NimBLE
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# Flash a oddíly: BLE aplikace potřebuje víc místa než výchozí 1MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA přes Wi-Fi: BLE a Wi-Fi běží současně (softwarová koexistence)
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y

# OLED: 1.3" s radicem SH1106 (pro 0.96" SSD1306 prepni v menuconfigu)
CONFIG_CASOMIRA_OLED_SH1106=y

# Heslo/Pin pro spojeni s casomirou
CONFIG_CASOMIRA_PIN="1234"

# Nazev casomiry v Bluetooth siti
CONFIG_CASOMIRA_BLE_NAME="Casomira"

# Bezpecnostni prodleva po prvnim preruseni opticke brany v milisekundach
# Sportovec totiz musi mit dostatek casu, aby dokazal opustit jeji prostor
# Vychozi 3 sekundy by mely stacit i pro deti na odrazedlech ;-)
CONFIG_CASOMIRA_BLIND_MS=3000
